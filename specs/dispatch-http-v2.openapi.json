    "/dispatches": {
      "post": {
        "operationId": "submitDispatch",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/DispatchID"
            },
            "description": "Equals request.dispatch_id. Scope by authenticated caller; compare exact request body digest."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exact replay; return original handle.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Handle"
                }
              }
            }
          },
          "201": {
            "description": "Durably accepted one dispatch.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Handle"
                }
              }
            }
          },
          "400": {
            "description": "Malformed or invalid request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer credential.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks permission for this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key reused with a different body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body or inline artifact exceeds a limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Error"
                }
              }
            }
          },
          "415": {
            "description": "Not UTF-8 application/json with identity content encoding.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Error"
                }
              }
            }
          },
          "422": {
            "description": "Unsupported protocol or required capability.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited; retry only after Retry-After within the caller deadline.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "required": true,
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Error"
                }
              }
            }
          },
          "default": {
            "description": "Other provider error; fail closed for unknown status or error code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    },
    "/dispatches/{dispatch_id}": {
      "parameters": [
        {
          "name": "dispatch_id",
