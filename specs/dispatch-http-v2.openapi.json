    "/dispatches/{dispatch_id}/cancel": {
      "parameters": [
        {
          "name": "dispatch_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/DispatchID"
          }
        }
      ],
      "post": {
        "operationId": "cancelDispatch",
        "responses": {
          "200": {
            "description": "Dispatch is already terminal; no mutation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Status"
                }
              }
            }
          },
          "202": {
            "description": "Cancellation requested, not necessarily completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Status"
                }
              }
            }
          },
          "400": {
            "description": "Malformed or invalid request.",
            "content": {
              "application/json": {
