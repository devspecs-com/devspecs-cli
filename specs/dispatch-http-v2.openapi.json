                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited; retry only after Retry-After within the caller deadline.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "required": true,
