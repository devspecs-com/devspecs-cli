{
  "openapi": "3.1.0",
  "info": {
    "title": "DevSpecs HTTP dispatch provider",
    "version": "2.0.0-draft",
    "description": "Review draft. No specs.place service dependency. Paths are relative to the explicitly configured provider base URL."
  },
  "servers": [
    {
      "url": "https://provider.example/devspecs/v2"
    }
  ],
  "security": [
    {
      "ProviderToken": []
    }
  ],
  "paths": {
    "/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "responses": {
          "200": {
            "description": "Version, supported features and configured-principal readiness.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Capabilities"
                }
              }
            }
          },
          "400": {
            "description": "Malformed or invalid request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer credential.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks permission for this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited; retry only after Retry-After within the caller deadline.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "required": true,
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Error"
                }
              }
            }
          },
          "default": {
            "description": "Other provider error; fail closed for unknown status or error code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../internal/orchestration/http_dispatch_v2.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
